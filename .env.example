# Pioniersplanner environment
# Copy to .env for local use:  cp .env.example .env
# Local demo stores data in the browser; nothing below is required to run `npm run dev`.

# Dev/production listen port (used by npm run dev / npm start).
PORT=4321

# Public site URL (no trailing slash). Used if you later add metadata, sitemap, or sharing.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:4321

# Optional later: Supabase for real accounts and sync (not wired in this version).
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
