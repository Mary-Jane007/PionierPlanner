# Pioniersplanner environment
# Copy to .env for local use:  cp .env.example .env

# Dev/production listen port (used by npm run dev / npm start).
# Render sets PORT automatically. `npm start` serves `out/` plus /api/cloud.
PORT=4321

# Public site URL (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:4321

# Cloud accounts (Neon). Required so a new account works on every device.
# Get a connection string at https://console.neon.tech
DATABASE_URL=

# Signs login tokens. Use a long random string.
AUTH_SECRET=

# Optional: if the web app is hosted separately from the API (e.g. GitHub Pages or the Android/iOS app).
# Leave empty on Render so the app uses same-origin /api/cloud.
# Native APK/IPA builds should set this to the live site. Never put DATABASE_URL or AUTH_SECRET in the mobile app.
# NEXT_PUBLIC_API_URL=https://pionierplanner.onrender.com
