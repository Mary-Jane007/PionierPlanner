# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# stray capacitor-assets PWA output (real icons live in public/icons)
/icons

# android / capacitor build
android/.gradle/
android/app/build/
android/build/
android/captures/
android/local.properties
android/.idea/
*.iml
*.apk
!public/downloads/*.apk
!public/downloads/*.zip
*.aab
!public/downloads/*.aab

# android / ios signing and generated native build output
android/release.keystore
android/keystore.properties
ios/App/Pods/
ios/App/App/public/
ios/DerivedData/
*.xcuserstate

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep .env.example as the committed template)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
